# Copy to .env and fill in values before deploying
# Used by docker-compose.prod.yml (docker compose --env-file .env -f docker-compose.prod.yml up -d)

# ── Core ────────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-long-random-string
DOMAIN=risksentinel.yourdomain.com
WORKERS=4
TIMEOUT=120

# ── LevelBlue / AlienVault USM importer ─────────────────────────────────────
LEVELBLUE_BASE_URL=https://nebula-group.alienvault.cloud
LEVELBLUE_CLIENT_ID=
LEVELBLUE_CLIENT_SECRET=

# ── Rapid7 InsightVM Cloud importer ─────────────────────────────────────────
# Region one of: us, us2, us3, eu, ca, au, ap
RAPID7_API_KEY=
RAPID7_REGION=eu
